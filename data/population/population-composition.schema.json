{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Population Composition v1",
  "description":"Shares additionally require registered IDs and an exact sum of 10000, enforced by the generator.",
  "type":"object","additionalProperties":false,"required":["version","rules"],
  "properties":{"version":{"const":1},"rules":{"type":"array","items":{"$ref":"#/$defs/rule"}}},
  "$defs":{
    "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
    "shares":{"type":"object","minProperties":1,"additionalProperties":{"type":"integer","minimum":0,"maximum":10000}},
    "match":{
      "type":"object","additionalProperties":false,
      "properties":{
        "territoryId":{"type":"string","minLength":1},
        "territoryIds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "sourceCountry":{"type":"string","pattern":"^[A-Z]{3}$"},
        "settlement":{"enum":["rural","urban"]},
        "stratumId":{"$ref":"#/$defs/id"},
        "bbox":{"type":"array","minItems":4,"maxItems":4,"prefixItems":[{"type":"number","minimum":-180,"maximum":180},{"type":"number","minimum":-90,"maximum":90},{"type":"number","minimum":-180,"maximum":180},{"type":"number","minimum":-90,"maximum":90}]}
      }
    },
    "rule":{
      "type":"object","additionalProperties":false,"required":["id","match"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},"match":{"$ref":"#/$defs/match"},
        "cultureShares":{"$ref":"#/$defs/shares"},"religionShares":{"$ref":"#/$defs/shares"},"stratumShares":{"$ref":"#/$defs/shares"},
        "literacyBps":{"type":["integer","null"],"minimum":0,"maximum":10000}
      },
      "anyOf":[{"required":["cultureShares"]},{"required":["religionShares"]},{"required":["stratumShares"]},{"required":["literacyBps"]}],
      "allOf":[{"if":{"properties":{"match":{"required":["stratumId"]}}},"then":{"not":{"anyOf":[{"required":["cultureShares"]},{"required":["religionShares"]},{"required":["stratumShares"]}]}}}]
    }
  }
}
